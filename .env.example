# Banco
PGHOST=localhost
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app

# Destino (MinIO local; para AWS real, remova S3_ENDPOINT_URL e use credenciais/região reais)
S3_BUCKET=backups
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Retenção
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Notificações (opcional)
SLACK_WEBHOOK_URL=
